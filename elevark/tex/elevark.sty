% Felles oppsett for elevarkene på lektorbo.no. Kompileres med lualatex.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{elevark}[2026/11/18 Elevark for lektorbo.no]

\RequirePackage[a4paper,margin=2cm,top=1.7cm,bottom=2.2cm]{geometry}
\RequirePackage[norsk]{babel}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\setmainfont{LibertinusSerif}[Extension=.otf, UprightFont=*-Regular, BoldFont=*-Bold, ItalicFont=*-Italic, BoldItalicFont=*-BoldItalic]
\setsansfont{LibertinusSans}[Extension=.otf, UprightFont=*-Regular, BoldFont=*-Bold, ItalicFont=*-Italic]
\setmonofont{LibertinusMono}[Extension=.otf, UprightFont=*-Regular, Scale=0.95]
\setmathfont{LibertinusMath-Regular.otf}

\RequirePackage{xcolor}
\definecolor{blekk}{HTML}{16213A}
\definecolor{dempet}{HTML}{566077}
\definecolor{rute}{HTML}{CFC9B8}
\definecolor{fasegjett}{HTML}{BF3F0B}
\definecolor{fasetest}{HTML}{0C7168}
\definecolor{faseforklar}{HTML}{16213A}
\definecolor{faseutfordring}{HTML}{566077}

\RequirePackage{enumitem}
\RequirePackage{tabularx,booktabs,array}
\RequirePackage[most]{tcolorbox}
\RequirePackage{qrcode}
\RequirePackage{needspace}
\RequirePackage{fancyhdr}
\RequirePackage[hidelinks]{hyperref}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.45em}
\linespread{1.06}
\raggedbottom
\setlength{\emergencystretch}{3em}

% Overskrifter
\RequirePackage{titlesec}
\titleformat{\section}{\sffamily\bfseries\large\color{blekk}}{}{0pt}{}
\titlespacing*{\section}{0pt}{1.3em}{0.4em}
\titleformat{\subsection}{\sffamily\bfseries\normalsize\color{blekk}}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{1em}{0.3em}

% Topptekst og bunntekst
\newcommand{\arkadresse}{}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\sffamily\scriptsize\color{dempet}\arkadresse}
\fancyfoot[R]{\sffamily\scriptsize\color{dempet}Side \thepage}

% Hode med tittel, navnelinje og QR-kode til nettsiden
\newcommand{\elevarkhode}[4]{% #1 fag og tema, #2 tittel, #3 nettadresse, #4 tekst under QR-koden
  \renewcommand{\arkadresse}{#3}%
  \thispagestyle{fancy}%
  \noindent\begin{minipage}[t]{0.79\linewidth}\vspace{0pt}
    {\sffamily\small\color{dempet}lektorbo.no · #1}\par\vspace{3pt}
    {\sffamily\bfseries\LARGE\color{blekk}#2\par}\vspace{12pt}
    {\sffamily\small Navn: \rule[-2pt]{6.5cm}{0.4pt}\qquad Dato: \rule[-2pt]{3cm}{0.4pt}}
  \end{minipage}\hfill
  \begin{minipage}[t]{0.17\linewidth}\vspace{0pt}\raggedleft
    \qrcode[height=2.2cm]{#3}\par\vspace{2pt}
    {\sffamily\scriptsize\color{dempet}#4}
  \end{minipage}\par
  \vspace{4pt}{\color{rute}\rule{\linewidth}{0.6pt}}\par\vspace{2pt}}

% Fasemerker: Gjett, Test, Forklar, Utfordring
\newtcbox{\fasebox}[1]{on line, colframe=#1, colback=#1!7, coltext=#1!85!black,
  boxrule=0.5pt, arc=1.5pt, left=3pt, right=3pt, top=0.6pt, bottom=0.6pt,
  boxsep=0pt, fontupper=\sffamily\bfseries\footnotesize}
\newcommand{\fase}[2]{\fasebox{fase#1}{#2}\enspace}

% Svarplass etter hver oppgave. Endre høyden her, eller med \setlength i det enkelte arket.
\newlength{\svarhoyde}
\setlength{\svarhoyde}{2.4cm}
\newcommand{\svar}{\par\vspace{\svarhoyde}}

\newenvironment{oppgaveliste}%
  {\begin{enumerate}[label=\sffamily\bfseries\arabic*., leftmargin=1.6em, itemsep=0.3em, topsep=0.3em]}%
  {\end{enumerate}}
\newcommand{\oppgave}{\needspace{4\baselineskip}\item}

\setlist[itemize]{leftmargin=1.4em, itemsep=0.1em, topsep=0.2em}
\setlist[enumerate]{itemsep=0.1em, topsep=0.2em}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}

\endinput
